diff --git a/.gitignore b/.gitignore
index 15cbc7f..f1bc662 100644
--- a/.gitignore
+++ b/.gitignore
@@ -14,6 +14,13 @@ dist-ssr

 build/

+# Runtime uploads — these live only on the Hostinger server, never in the build.
+uploads/
+public/uploads/
