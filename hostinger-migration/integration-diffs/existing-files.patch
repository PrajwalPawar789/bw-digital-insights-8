diff --git a/public/.htaccess b/public/.htaccess
index 6e17b28..f22bfeb 100644
--- a/public/.htaccess
+++ b/public/.htaccess
@@ -1,9 +1,15 @@
 RewriteEngine On

+# No directory listings (especially for /uploads/).
+Options -Indexes
+
 # Ensure PHP proxy works with path-info URLs:
 # /supabase-proxy.php/rest/v1/...
 RewriteRule ^supabase-proxy\.php(/.*)?$ - [L,NC]

+# Hostinger-hosted upload endpoint (replaces Supabase storage).
+RewriteRule ^upload\.php(/.*)?$ - [L,NC]
+
 # Preserve Authorization header for PHP under some Apache/FastCGI setups.
 RewriteCond %{HTTP:Authorization} .
 RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
